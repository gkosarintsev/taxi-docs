@startuml scheduled-rides-dispatch
skinparam monochrome false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam defaultFontSize 12
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2980B9
}

|#E8F4F8| Passenger (Rider) |
start
:Book Scheduled Ride (T_pickup in Advance);

|#FDF2E9| Scheduled Ride Scheduler |
:Store Reservation in Database;
:Calculate Driver Match Window (T_pickup - 30 mins);
:Wait for Trigger Window (Cron / Delay Queue);

|#FEF9E7| Advance Matching Engine |
:Query High-Rating Drivers (Rating >= 4.85);
:Send Advance Offer to Candidate Driver;

|#EAECEE| Driver Partner |
if (Driver Accepts Advance Offer?) then (Accepted)
  |#E8F8F5| Liveness Monitoring Loop |
  :Lock Reservation to Driver;
  :Start Liveness Heartbeat Check at T_pickup - 20 mins;
  if (Driver Online & Moving Toward Pickup?) then (Active & Healthy)
    :Dispatch Final Trip Start at T_pickup - 10 mins;
    :Transition to Standard Ride Execution Flow;
    stop
  else (Unresponsive / Offline / No Movement)
    |#FADBD8| Emergency Fallback Engine |
    :Cancel Driver Assignment with Penalty;
    :Trigger High-Priority Instant Dispatch;
    :Assign Nearest Dedicated Hot-Standby Driver;
    :Notify Passenger of Seamless Driver Reassignment;
    stop
  endif
else (Declined / 60s Timeout)
  |#FDF2E9| Scheduled Ride Scheduler |
  :Fall Back to Standard Dynamic Dispatch Pool at T - 15m;
  :Broadcast Request to General Driver Pool;
  stop
endif
@enduml
